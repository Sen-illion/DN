{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dn.local/schemas/human_rating_v1.schema.json",
  "title": "DNHumanRatingV1",
  "type": "object",
  "required": ["sample_id", "modality", "rater_id", "confidence", "reasons"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "modality": {"type": "string", "enum": ["text", "image"]},
    "rater_id": {"type": "string", "minLength": 1},
    "text_coherence_1to5": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "overall_score": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "semantic_consistency": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "subject_attribute_consistency": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "spatial_consistency": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "style_lighting_consistency": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "detail_integrity": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "disqualifying_defect_0or1": {"type": ["integer", "null"], "enum": [0, 1, null]},
    "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "failure_tags": {"type": "array", "items": {"type": "string"}},
    "adjudication_needed_0or1": {"type": ["integer", "null"], "enum": [0, 1, null]},
    "adjudicated_score": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "comment": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
