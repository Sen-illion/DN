{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dn.local/schemas/multiview_judgement.schema.json",
  "title": "MultiViewJudgement",
  "type": "object",
  "required": [
    "sample_id",
    "judge_model",
    "overall_score",
    "dimension_scores",
    "confidence",
    "reasons"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "judge_model": {
      "type": "string",
      "minLength": 1
    },
    "overall_score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "dimension_scores": {
      "type": "object",
      "required": [
        "semantic_consistency",
        "subject_attribute_consistency",
        "spatial_consistency",
        "style_lighting_consistency",
        "detail_integrity"
      ],
      "additionalProperties": false,
      "properties": {
        "semantic_consistency": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "subject_attribute_consistency": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "spatial_consistency": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "style_lighting_consistency": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "detail_integrity": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "failure_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
